    .alert-symbol {
        display: grid;
        place-items: center;
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        border-radius: 12px;
        background: #ffffffa0;
        font-size: 24px;
        font-weight: 800;
    }

    .alert-copy {
        flex: 1;
    }

    .alert-copy strong {
        display: block;
        font-size: 13px;
        letter-spacing: .3px;
    }

    .alert-copy p {
        margin: 6px 0 0;
        font-size: 12px;
        line-height: 1.5;
    }

    .alert-right {
        text-align: right;
    }

    .alert-right span,
    .alert-right strong {
        display: block;
    }

    .alert-right span {
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .alert-right strong {
        margin-top: 5px;
        font-size: 26px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 17px;
        margin-bottom: 23px;
    }

    .summary-card,
    .panel {
        background: #fff;
        border: 1px solid #e7edf5;
        border-radius: 15px;
        box-shadow: 0 5px 18px #24365307;
    }

    .summary-card {
        min-width: 0;
        padding: 21px;
    }

    .summary-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        color: #64748b;
        font-size: 12px;
    }

    .summary-icon {
        display: grid;
        place-items: center;
        width: 37px;
        height: 37px;
        border-radius: 11px;
        font-size: 21px;
        font-weight: 700;
    }

    .blue-icon {
        background: #e0f2fe;
        color: #0284c7;
    }

    .purple-icon {
        background: #ede9fe;
        color: #7c3aed;
    }

    .summary-number {
        margin-top: 20px;
        font-size: 32px;
        font-weight: 800;
        letter-spacing: -1px;
    }

    .summary-number span {
        color: #64748b;
        font-size: 15px;
        font-weight: 600;
    }

    .summary-caption {
        margin-top: 8px;
        color: #8995a7;
        font-size: 11px;
    }

    .mini-progress {
        height: 6px;
        margin-top: 19px;
        overflow: hidden;
        border-radius: 20px;
        background: #e9eff6;
    }

    .mini-progress div {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #38bdf8, #2563eb);
        transition: width .5s ease;
    }

    .summary-status {
        margin-top: 23px;
        font-size: 27px;
        font-weight: 800;
    }

