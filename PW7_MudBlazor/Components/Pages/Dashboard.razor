        background: #fee2e2;
        color: #991b1b;
    }

    .offline .connection-dot {
        background: #dc2626;
    }

    .alert-banner {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 18px 22px;
        margin-bottom: 22px;
        border: 1px solid transparent;
        border-radius: 15px;
