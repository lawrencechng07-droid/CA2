@page "/dashboard"
@page "/"
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Smart Water Tank Dashboard</PageTitle>

<div class="app-shell">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-icon">≋</div>
            <div>
                <h2>AquaSense</h2>
                <span>INDUSTRIAL IIoT</span>
            </div>
        </div>

        <div class="nav-heading">MAIN MENU</div>

        <div class="nav-item active">
            <span>▦</span> Dashboard
        </div>

        <div class="nav-item">
            <span>◉</span> Tank Monitoring
        </div>

        <div class="nav-item">
            <span>⌁</span> Sensor Status
        </div>

        <div class="sidebar-bottom">
            <div class="sidebar-status">
                <span class="pulse-dot"></span>
                <div>
                    <strong>System Monitoring</strong>
                    <small>Live data polling</small>
                </div>
            </div>
            <small class="sidebar-footer">AquaSense IIoT v1.0</small>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">

        <!-- HEADER -->
        <header class="topbar">
            <div>
                <div class="eyebrow">INDUSTRIAL CONTROL SYSTEM</div>
                <h1>Water Tank Monitoring</h1>
                <p>Monitor water levels, sensors and safety conditions in real time.</p>
            </div>

            <div class="connection-pill @(_data?.Connected == true ? "online" : "offline")">
                <span class="connection-dot"></span>
                @(_data?.Connected == true ? "MQTT ONLINE" : "MQTT OFFLINE")
            </div>
        </header>

        <!-- STATUS BANNER -->
        <section class="alert-banner @GetAlertClass()">
            <div class="alert-symbol">@GetAlertSymbol()</div>
            <div class="alert-copy">
                <strong>@GetConditionTitle()</strong>
                <p>@GetConditionDescription()</p>
            </div>
            <div class="alert-right">
                <span>WATER LEVEL</span>
                <strong>@(_data?.WaterLevel is double level ? $"{level:F0}%" : "--")</strong>
            </div>
        </section>

        <!-- SUMMARY CARDS -->
        <section class="summary-grid">

            <div class="summary-card">
                <div class="summary-top">
                    <span>Water Level</span>
                    <div class="summary-icon blue-icon">≋</div>
                </div>
                <div class="summary-number">
                    @(_data?.WaterLevel is double wl ? $"{wl:F1}" : "--")
                    <span>%</span>
                </div>
                <div class="summary-caption">Tank capacity percentage</div>
                <div class="mini-progress">
                    <div style="@($"width:{GetWaterLevelWidth()}")"></div>
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-top">
                    <span>Water Level Status</span>
                    <div class="summary-icon @GetStateIconClass()">◉</div>
                </div>
                <div class="summary-status @GetStateTextClass()">
                    @GetWaterLevelState()
                </div>
                <div class="summary-caption">Based on configured thresholds</div>
                <div class="summary-footer">
                    <span class="small-dot @GetStateDotClass()"></span>
                    @_data?.LastUpdate ?? "Waiting for PLC data"
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-top">
                    <span>Input Voltage</span>
                    <div class="summary-icon purple-icon">ϟ</div>
                </div>
                <div class="summary-number">
                    @(_data?.Voltage is double v ? $"{v:F2}" : "--")
                    <span>V</span>
                </div>
                <div class="summary-caption">PLC analog input reading</div>
                <div class="voltage-note">Live PLC measurement</div>
            </div>

        </section>

        <!-- MAIN VISUALIZATION -->
        <section class="content-grid">

            <!-- WATER TANK -->
            <div class="panel tank-panel">
                <div class="panel-header">
                    <div>
                        <h2>Tank Visualization</h2>
                        <p>Live water level representation</p>
                    </div>
                    <span class="tag">TANK 01</span>
                </div>

                <div class="tank-layout">

                    <div class="tank-visual">
                        <div class="tank-top-cap"></div>

                        <div class="tank-body">
                            <div class="tank-scale">
                                <span>100%</span>
                                <span>75%</span>
                                <span>50%</span>
                                <span>25%</span>
                                <span>0%</span>
                            </div>

                            <div class="tank-interior">
                                <div class="tank-grid-lines"></div>

                                @if (_data?.WaterLevel is double tankLevel)
                                {
                                    <div class="water"
                                         style="@($"height:{Math.Clamp(tankLevel, 0, 100):F1}%")">
                                        <div class="wave wave-one"></div>
                                        <div class="wave wave-two"></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="water unknown-water" style="height:0%"></div>
                                }

                                <div class="tank-percentage">
                                    @(_data?.WaterLevel is double currentLevel
                                        ? $"{currentLevel:F0}%"
                                        : "--")
                                </div>
                            </div>
                        </div>

                        <div class="tank-bottom-cap"></div>

                        <div class="tank-pipe">
                            <div class="pipe-joint"></div>
                        </div>
                    </div>

                    <div class="tank-details">
                        <div class="detail-label">CURRENT LEVEL</div>
                        <div class="big-level">
                            @(_data?.WaterLevel is double bigLevel
                                ? $"{bigLevel:F1}"
                                : "--")
                            <span>%</span>
                        </div>

                        <div class="detail-label">OPERATING CONDITION</div>
                        <div class="condition-chip @GetStateTextClass()">
                            <span class="small-dot @GetStateDotClass()"></span>
                            @GetWaterLevelState()
                        </div>

                        <div class="level-legend">
                            <div>
                                <span class="legend-dot green"></span>
                                <span>Normal</span>
                            </div>
                            <div>
                                <span class="legend-dot yellow"></span>
                                <span>Warning</span>
                            </div>
                            <div>
                                <span class="legend-dot red"></span>
                                <span>Danger</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SENSOR STATUS -->
            <div class="panel sensor-panel">
                <div class="panel-header">
                    <div>
                        <h2>Sensor Monitoring</h2>
                        <p>Digital input status</p>
                    </div>
                    <span class="sensor-count">2 INPUTS</span>
                </div>

                <div class="sensor-row">
                    <div class="sensor-icon">PB</div>
                    <div class="sensor-info">
                        <strong>Push Button</strong>
                        <small>Digital Input 1</small>
                    </div>
                    <span class="state-pill @GetBoolClass(_data?.PushButton)">
                        @GetBoolText(_data?.PushButton)
                    </span>
                </div>

                <div class="sensor-row">
                    <div class="sensor-icon">PNP</div>
                    <div class="sensor-info">
                        <strong>Proximity Sensor</strong>
                        <small>Digital Input 2</small>
                    </div>
                    <span class="state-pill @GetBoolClass(_data?.SensorPnp)">
                        @GetBoolText(_data?.SensorPnp)
                    </span>
                </div>

                <div class="sensor-note">
                    <span>ⓘ</span>
                    Sensor readings are received from the WAGO PLC through MQTT.
                </div>
            </div>
        </section>

        <!-- INDICATOR LIGHTS -->
        <section class="panel indicator-panel">
            <div class="panel-header">
                <div>
                    <h2>Water Level Indicators</h2>
                    <p>Physical indicator output status reported by the PLC</p>
                </div>
                <span class="tag">PLC OUTPUTS</span>
            </div>

            <div class="indicator-grid">

                <div class="indicator-card green-card @(_data?.GreenLight == true ? "active-indicator" : "")">
                    <div class="lamp green-lamp @(_data?.GreenLight == true ? "lamp-on" : "")">
                        <span></span>
                    </div>
                    <div class="indicator-info">
                        <h3>Green Light</h3>
                        <p>Normal water level</p>
                        <span class="indicator-state @GetBoolClass(_data?.GreenLight)">
                            @GetBoolText(_data?.GreenLight)
                        </span>
                    </div>
                    <div class="indicator-number">01</div>
                </div>

                <div class="indicator-card yellow-card @(_data?.YellowLight == true ? "active-indicator" : "")">
                    <div class="lamp yellow-lamp @(_data?.YellowLight == true ? "lamp-on" : "")">
                        <span></span>
                    </div>
                    <div class="indicator-info">
                        <h3>Yellow Light</h3>
                        <p>Water level warning</p>
                        <span class="indicator-state @GetBoolClass(_data?.YellowLight)">
                            @GetBoolText(_data?.YellowLight)
                        </span>
                    </div>
                    <div class="indicator-number">02</div>
                </div>

                <div class="indicator-card red-card @(_data?.RedLight == true ? "active-indicator" : "")">
                    <div class="lamp red-lamp @(_data?.RedLight == true ? "lamp-on" : "")">
                        <span></span>
                    </div>
                    <div class="indicator-info">
                        <h3>Red Light</h3>
                        <p>Danger water level</p>
                        <span class="indicator-state @GetBoolClass(_data?.RedLight)">
                            @GetBoolText(_data?.RedLight)
                        </span>
                    </div>
                    <div class="indicator-number">03</div>
                </div>

            </div>
        </section>

        <!-- SYSTEM INFORMATION -->
        <section class="bottom-grid">
            <div class="panel system-panel">
                <div class="panel-header">
                    <div>
                        <h2>System Information</h2>
                        <p>Communication and device details</p>
                    </div>
                </div>

                <div class="system-row">
                    <span>Controller</span>
                    <strong>WAGO PLC</strong>
                </div>
                <div class="system-row">
                    <span>Device ID</span>
                    <strong>PLC_111</strong>
                </div>
                <div class="system-row">
                    <span>MQTT Broker</span>
                    <strong>192.168.101.125:1883</strong>
                </div>
                <div class="system-row">
                    <span>Communication</span>
                    <strong>MQTT</strong>
                </div>
                <div class="system-row">
                    <span>Last Update</span>
                    <strong>@(_data?.LastUpdate ?? "Waiting for data...")</strong>
                </div>
            </div>

            <div class="panel logic-panel">
                <div class="panel-header">
                    <div>
                        <h2>Indicator Logic</h2>
                        <p>Water level condition reference</p>
                    </div>
                </div>

                <div class="logic-row">
                    <span class="logic-circle green">G</span>
                    <div>
                        <strong>Normal</strong>
                        <p>Green indicator is ON.</p>
                    </div>
                </div>

                <div class="logic-row">
                    <span class="logic-circle yellow">Y</span>
                    <div>
                        <strong>Warning</strong>
                        <p>Yellow indicator is ON.</p>
                    </div>
                </div>

                <div class="logic-row">
                    <span class="logic-circle red">R</span>
                    <div>
                        <strong>Danger</strong>
                        <p>Red indicator is ON.</p>
                    </div>
                </div>

                <div class="logic-footnote">
                    Thresholds must match the values configured in your PLC program.
                </div>
            </div>
        </section>

        <footer>
            <span>AquaSense IIoT</span>
            <span>WAGO PLC Water Tank Monitoring System</span>
            <span>Dashboard refresh: 1 second</span>
        </footer>

    </main>
</div>

@code {
    private DashboardData? _data;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    // Example percentage thresholds.
    // Change these values to match your CODESYS PLC logic.
    private const double DangerLow = 15;
    private const double WarningLow = 30;
    private const double WarningHigh = 90;
    private const double DangerHigh = 95;

    protected override async Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        await RefreshDataAsync();
        _ = PollDashboardAsync(_cts.Token);
    }

    private async Task PollDashboardAsync(CancellationToken token)
    {
        try
        {
            while (_timer != null &&
                   await _timer.WaitForNextTickAsync(token))
            {
                await RefreshDataAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Component has been disposed.
        }
    }

    private async Task RefreshDataAsync()
    {
        try
        {
            var url = new Uri(new Uri(Navigation.BaseUri), "api/status");
            _data = await Http.GetFromJsonAsync<DashboardData>(url);
        }
        catch (HttpRequestException)
        {
            // Retain the last received values if the API is unavailable.
        }
        catch (System.Text.Json.JsonException)
        {
            // Ignore an invalid response and retry on the next poll.
        }
    }

    private string GetWaterLevelState()
    {
        if (_data?.WaterLevel is not double level)
            return "NO DATA";

        if (level < 0 || level > 100)
            return "INVALID LEVEL";

        if (level <= DangerLow || level >= DangerHigh)
            return "DANGER";

        if (level <= WarningLow || level >= WarningHigh)
            return "WARNING";

        return "NORMAL";
    }

    private string GetConditionTitle() => GetWaterLevelState() switch
    {
        "NORMAL" => "WATER LEVEL NORMAL",
        "WARNING" => "WATER LEVEL WARNING",
        "DANGER" => "DANGER — IMMEDIATE ATTENTION",
        "INVALID LEVEL" => "INVALID WATER LEVEL READING",
        _ => "WAITING FOR WATER LEVEL DATA"
    };

    private string GetConditionDescription() => GetWaterLevelState() switch
    {
        "NORMAL" => "Water level is within the configured normal operating range.",
        "WARNING" => "Water level is approaching a configured limit. Check the tank.",
        "DANGER" => "Critical water level detected. Check the system and follow site procedures.",
        "INVALID LEVEL" => "The reported water level is outside the valid 0–100% range.",
        _ => "Waiting for a valid water level measurement from the PLC."
    };

    private string GetAlertClass() => GetWaterLevelState() switch
    {
        "NORMAL" => "alert-normal",
        "WARNING" => "alert-warning",
        "DANGER" => "alert-danger",
        _ => "alert-unknown"
    };

    private string GetAlertSymbol() => GetWaterLevelState() switch
    {
        "NORMAL" => "✓",
        "WARNING" => "!",
        "DANGER" => "⚠",
        _ => "…"
    };

    private string GetStateTextClass() => GetWaterLevelState() switch
    {
        "NORMAL" => "text-green",
        "WARNING" => "text-yellow",
        "DANGER" => "text-red",
        _ => "text-muted"
    };

    private string GetStateIconClass() => GetStateTextClass();

    private string GetStateDotClass() => GetWaterLevelState() switch
    {
        "NORMAL" => "green",
        "WARNING" => "yellow",
        "DANGER" => "red",
        _ => "gray"
    };

    private string GetWaterLevelWidth() =>
        _data?.WaterLevel is double level && level >= 0 && level <= 100
            ? $"{level:F1}%"
            : "0%";

    private static string GetBoolText(bool? value) =>
        value == true ? "ON" :
        value == false ? "OFF" : "NO DATA";

    private static string GetBoolClass(bool? value) =>
        value == true ? "state-on" :
        value == false ? "state-off" : "state-unknown";

    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
    }

    public sealed class DashboardData
    {
        [JsonPropertyName("connected")]
        public bool Connected { get; set; }

        [JsonPropertyName("waterLevel")]
        public double? WaterLevel { get; set; }

        [JsonPropertyName("pushButton")]
        public bool? PushButton { get; set; }

        [JsonPropertyName("sensorPnp")]
        public bool? SensorPnp { get; set; }

        [JsonPropertyName("greenLight")]
        public bool? GreenLight { get; set; }

        [JsonPropertyName("yellowLight")]
        public bool? YellowLight { get; set; }

        [JsonPropertyName("redLight")]
        public bool? RedLight { get; set; }

        [JsonPropertyName("voltage")]
        public double? Voltage { get; set; }

        [JsonPropertyName("lastUpdate")]
        public string? LastUpdate { get; set; }
    }
}

<style>
    :root {
        color-scheme: light;
    }

    .app-shell {
        display: flex;
        min-height: 100vh;
        margin: -16px;
        background: #f3f6fb;
        color: #172338;
        font-family: Inter, "Segoe UI", Arial, sans-serif;
    }

    .sidebar {
        width: 245px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        padding: 28px 18px 20px;
        background: #101b2d;
        color: #fff;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 0 8px 38px;
    }

    .brand-icon {
        display: grid;
        place-items: center;
        width: 45px;
        height: 45px;
        border-radius: 14px;
        background: linear-gradient(135deg, #38bdf8, #2563eb);
        color: white;
        font-size: 29px;
        font-weight: 700;
    }

    .brand h2 {
        margin: 0;
        font-size: 21px;
        letter-spacing: -.5px;
    }

    .brand span {
        display: block;
        margin-top: 4px;
        color: #91a3bd;
        font-size: 9px;
        letter-spacing: 1.8px;
    }

    .nav-heading {
        padding: 0 12px 12px;
        color: #71839e;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
    }

    .nav-item {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 8px;
        padding: 14px 13px;
        border-radius: 10px;
        color: #aab8cc;
        font-size: 13px;
    }

    .nav-item span {
        font-size: 19px;
    }

    .nav-item.active {
        background: #1d3556;
        color: #fff;
        box-shadow: inset 3px 0 #38bdf8;
    }

    .sidebar-bottom {
        margin-top: auto;
    }

    .sidebar-status {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 10px;
        border: 1px solid #293a51;
        border-radius: 12px;
    }

    .pulse-dot,
    .connection-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .pulse-dot {
        background: #4ade80;
        box-shadow: 0 0 0 5px #4ade801b;
    }

    .sidebar-status strong,
    .sidebar-status small {
        display: block;
    }

    .sidebar-status strong {
        font-size: 11px;
    }

    .sidebar-status small {
        margin-top: 5px;
        color: #8fa1bb;
        font-size: 10px;
    }

    .sidebar-footer {
        display: block;
        margin-top: 20px;
        text-align: center;
        color: #6d809c;
        font-size: 10px;
    }

    .main-content {
        flex: 1;
        min-width: 0;
        padding: 32px;
        overflow: hidden;
    }

    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        margin-bottom: 25px;
    }

    .eyebrow {
        margin-bottom: 8px;
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.8px;
    }

    .topbar h1 {
        margin: 0;
        font-size: clamp(24px, 3vw, 32px);
        letter-spacing: -1px;
    }

    .topbar p {
        margin: 9px 0 0;
        color: #718096;
        font-size: 13px;
    }

    .connection-pill {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 11px 14px;
        border-radius: 30px;
